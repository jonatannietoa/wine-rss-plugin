# Plantilla del entorno del proyecto. Cópiala a .env y rellena lo que uses:
#
#     cp .env.example .env
#
# .env está en .gitignore; esta plantilla no, así que NO pongas claves aquí.
# Una variable ya exportada en la shell gana sobre lo que diga .env.

# Clave de DeepSeek. La usa `eval/eval_session.py` como juez de deepeval, si no
# fuerzas otro con --juez. El plugin de dsh NO la necesita: las etapas 1 y 2 son
# deterministas y las que llamarán al modelo usarán el de la sesión del harness.
DEEPSEEK_API_KEY=

# Clave del juez de deepeval por defecto. Solo hace falta si evalúas con
# `eval/eval_session.py --juez openai`.
OPENAI_API_KEY=

# Modelo del juez cuando evalúas con DeepSeek. Por defecto deepseek-chat.
# DEEPSEEK_MODEL_NAME=deepseek-chat

# Pon 1 para que deepeval no mande telemetría.
# DEEPEVAL_TELEMETRY_OPT_OUT=1

# ── Pendiente: etapas 3, 4 y 5 del pipeline ─────────────────────────────────
# Todavía no las lee nada: la carga de catálogo (etapas 1 y 2) es determinista y
# no necesita ninguna clave. Se dejan aquí para que quede claro que las
# credenciales van en .env y no en catalog.config.yml, que solo guarda el NOMBRE
# de la variable (`shopify.tokenEnv`).

# Token de la Admin API de la tienda de Shopify a la que se publica.
# SHOPIFY_ADMIN_TOKEN=

# Clave del proveedor de búsqueda de imágenes de producto.
# IMAGE_SEARCH_API_KEY=

# Clave del proveedor de generación de imágenes.
# IMAGE_GENERATION_API_KEY=

