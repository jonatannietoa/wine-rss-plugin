# Plantilla del entorno del proyecto. Cópiala a .env y rellena lo que uses:
#
#     cp .env.example .env
#
# .env está en .gitignore; esta plantilla no, así que NO pongas claves aquí.
# Una variable ya exportada en la shell gana sobre lo que diga .env.

# Clave de DeepSeek. La usan dos cosas distintas:
#   - agent.py, como modelo del agente Python (sin ella corre en modo mock)
#   - eval/eval_session.py, como juez de deepeval si no fuerzas otro con --juez
# El plugin nativo de dsh NO la necesita: usa el modelo de la sesión del harness.
DEEPSEEK_API_KEY=

# Clave del juez de deepeval por defecto. Solo hace falta si evalúas con OpenAI
# (eval/test_wine_agent.py la pide siempre; eval/eval_session.py solo con --juez openai).
OPENAI_API_KEY=

# Modelo del juez cuando evalúas con DeepSeek. Por defecto deepseek-chat.
# DEEPSEEK_MODEL_NAME=deepseek-chat

# Pon 1 para que deepeval no mande telemetría.
# DEEPEVAL_TELEMETRY_OPT_OUT=1

# ── Pendiente: etapas del pipeline de catálogo ──────────────────────────────
# Todavía no las lee nada (ninguna etapa está implementada). Se dejan aquí para
# que quede claro que las credenciales van en .env y no en catalog.config.yml,
# que solo guarda el NOMBRE de la variable (`shopify.tokenEnv`).

# Token de la Admin API de la tienda de Shopify a la que se publica.
# SHOPIFY_ADMIN_TOKEN=

# Clave del proveedor de búsqueda de imágenes de producto.
# IMAGE_SEARCH_API_KEY=

# Clave del proveedor de generación de imágenes.
# IMAGE_GENERATION_API_KEY=

